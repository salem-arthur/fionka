{
  "name": "fionka",
  "version": "3.0.0",
  "private": true,
  "description": "Fionka Luxury E-Commerce — Cloudflare Pages",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB",
    "build": "echo 'Static site; no build needed'",
    "deploy": "npx wrangler pages deploy . --project-name fionka",
    "db:init": "npx wrangler d1 execute fionka-db --file=./schema.sql",
    "db:local": "npx wrangler d1 execute fionka-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
